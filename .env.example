# Postgres
POSTGRES_USER=secureship
POSTGRES_PASSWORD=secureship
POSTGRES_DB=secureship

# Backend
DATABASE_URL=postgresql://secureship:secureship@postgres:5432/secureship
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:8b
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=secureship_session
SESSION_COOKIE_SECURE=false
VERIFICATION_CODE_TTL_SECONDS=300
VERIFICATION_RESEND_COOLDOWN_SECONDS=30
VERIFICATION_MAX_ATTEMPTS=5
TOOL_CALL_MAX_ROUNDS=4

# Admin login (Auth0) — backend validates admin access tokens for /admin/*
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_ADMIN_CLIENT_ID=your-admin-spa-client-id

# Frontend (read by Vite, exposed as import.meta.env.VITE_API_URL)
VITE_API_URL=http://localhost:8000

# Frontend admin login (Auth0 SPA) — public values, no secrets
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your-admin-spa-client-id
VITE_AUTH0_AUDIENCE=https://your-api-identifier
